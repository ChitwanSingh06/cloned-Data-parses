BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Backend tuning (all optional)
PARSE_OCR_ENGINE=auto        # auto | paddle | tesseract
PARSE_OCR_DPI=200
PARSE_OCR_DENOISE=0          # 1 = OpenCV denoise (slow)
PARSE_MAX_UPLOAD_MB=50
PARSE_REVIEW_THRESHOLD=0.6
PARSE_HIGH_THRESHOLD=0.85
# Frontend: VITE_API_BASE=http://localhost:8000/api
# Windows: full path to tesseract.exe if it is not on PATH or in the default install folder
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
